include_guard(GLOBAL)
set(APP_UNIT_TEST_CLASSES "" CACHE STRING
  "Build these registered Qt unit classes (semicolon separated); empty builds the complete executable")

function(configure_focused_unit_build target metadata)
  cmake_parse_arguments(focus "" "" "SUPPORT_SOURCES" ${ARGN})
  if(NOT APP_UNIT_TEST_CLASSES)
    file(WRITE "${metadata}" "{\"mode\":\"complete\",\"requested_classes\":[]}\n")
    return()
  endif()
  if(APP_UNIT_TEST_CLASSES MATCHES "(^;|;;|;$)")
    message(FATAL_ERROR "APP_UNIT_TEST_CLASSES contains an empty class name")
  endif()
  set(requested ${APP_UNIT_TEST_CLASSES})
  set(unique ${requested})
  list(REMOVE_DUPLICATES unique)
  list(LENGTH requested count)
  list(LENGTH unique unique_count)
  if(NOT count EQUAL unique_count)
    message(FATAL_ERROR "APP_UNIT_TEST_CLASSES contains duplicate class names")
  endif()
  foreach(name IN LISTS requested)
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
      message(FATAL_ERROR "Invalid APP_UNIT_TEST_CLASSES name: '${name}'")
    endif()
  endforeach()
  get_target_property(sources ${target} SOURCES)
  set(selected)
  set(available)
  set(compiled)
  foreach(source IN LISTS sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(classes)
    if(EXISTS "${absolute}" AND NOT IS_DIRECTORY "${absolute}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${absolute}")
      file(STRINGS "${absolute}" registrations
        REGEX "^[ \t]*BITCOINQML_REGISTER_QT_TEST[ \t]*\\(")
      foreach(registration IN LISTS registrations)
        if(NOT registration MATCHES "^[ \t]*BITCOINQML_REGISTER_QT_TEST[ \t]*\\([ \t]*([A-Za-z_][A-Za-z0-9_]*)[ \t]*\\)")
          message(FATAL_ERROR "Unrecognized Qt unit registration in ${source}")
        endif()
        list(APPEND classes "${CMAKE_MATCH_1}")
      endforeach()
    endif()
    list(APPEND available ${classes})
    set(keep FALSE)
    if(NOT classes OR source IN_LIST focus_SUPPORT_SOURCES)
      set(keep TRUE)
    endif()
    foreach(name IN LISTS classes)
      if(name IN_LIST requested)
        set(keep TRUE)
      endif()
    endforeach()
    if(keep)
      list(APPEND selected "${source}")
      list(APPEND compiled ${classes})
    endif()
  endforeach()
  foreach(name IN LISTS requested)
    if(NOT name IN_LIST available)
      message(FATAL_ERROR "Requested unit class is unavailable in this configuration: ${name}")
    endif()
  endforeach()
  set_property(TARGET ${target} PROPERTY SOURCES ${selected})
  list(REMOVE_DUPLICATES compiled)
  list(SORT compiled)
  list(JOIN requested "\",\"" requested_json)
  list(JOIN compiled "\",\"" compiled_json)
  file(WRITE "${metadata}"
    "{\"mode\":\"focused\",\"requested_classes\":[\"${requested_json}\"],\"compiled_classes\":[\"${compiled_json}\"]}\n")
  message(STATUS "Focused Qt unit build requested: ${requested}")
  message(STATUS "Compiled Qt unit classes (including shared support): ${compiled}")
endfunction()
