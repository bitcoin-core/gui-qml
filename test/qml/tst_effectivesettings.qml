import QtQuick
import QtTest
import org.bitcoincore.qt 1.0
import "../../qml/components"
TestCase {
    id: testCase
    name: "EffectiveSettings"
    when: windowShown
    visible: true
    width: 1000
    height: 900
    Component { id: viewComponent; SettingsView { width: 1000; height: 900; selectedSectionId: "connection" } }
    Component { id: doneSpy; SignalSpy { signalName: "doneClicked" } }
    function init() { optionsModel.resetSettingsEditorsForTest(); optionsModel.settingsReady = true; optionsModel.settingsPending = false; optionsModel.settingsError = "" }
    function view() { const result = createTemporaryObject(viewComponent, testCase); verify(result !== null); verify(result.settingsEditor !== null); tryCompare(result.settingsEditor, "fresh", true); return result }
    function edit(result, key, text) { const input = findChild(result, key + "SettingInput"); verify(input !== null); input.text = text; input.textEdited(); tryCompare(result.settingsEditor.entry(key), "text", text); tryCompare(result.settingsEditor, "inputPending", false) }
    function save(result) { const button = findChild(result, "settingsSaveBatchButton"); verify(button !== null); tryCompare(button, "enabled", true); button.clicked(); tryVerify(() => result.settingsEditor.lastSavePersisted); tryCompare(result.settingsEditor, "busy", false) }
    function question(result, target) { result.selectSection(target); tryCompare(result.settingsEditor, "closeQuestion", true); tryCompare(findChild(result, "settingsCloseQuestion"), "visible", true) }
    function test_navigation_cannot_skip_an_input_waiting_for_domain() { const page = view(); const input = findChild(page, "proxySettingInput"); input.text = "127.0.0.1:9250"; input.textEdited(); page.requestSettingsNavigation("storage", false); tryCompare(page.settingsEditor, "closeQuestion", true); compare(page.selectedSectionId, "connection"); compare(page.pendingSettingsSection, "storage"); compare(optionsModel.settingsWritesForTest(), 0); findChild(page, "settingsCloseKeep").clicked(); tryCompare(page.settingsEditor, "closeQuestion", false); compare(page.settingsEditor.entry("proxy").text, "127.0.0.1:9250"); verify(page.settingsEditor.dirty) }
    function test_typed_values_and_loading_have_no_write_effect() { const page = view(); compare(page.settingsEditor.entry("listen").booleanValue, true); compare(page.settingsEditor.entry("proxy").text, ""); compare(page.settingsEditor.canSave, false); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_raw_invalid_integer_is_retained_outside_persistence() { const page = view(); page.selectSection("mempool"); edit(page, "maxmempool", "300x"); compare(page.settingsEditor.canSave, false); verify(page.settingsEditor.entry("maxmempool").error.length > 0); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_same_numeric_default_is_an_explicit_override_and_has_a_receipt() { const page = view(); page.selectSection("mempool"); edit(page, "maxmempool", "0300"); tryCompare(page.settingsEditor, "dirty", true); save(page); const result = page.settingsEditor.saveResult; compare(result.outcome, SettingsSaveResult.Saved); verify(result.operationId.indexOf(page.settingsEditor.editorId + ":") === 0); verify(result.actualValues.indexOf("maxmempool = 300") >= 0); compare(optionsModel.settingsWritesForTest(), 1); edit(page, "maxmempool", "0300"); compare(page.settingsEditor.dirty, false); compare(page.settingsEditor.canSave, false); compare(optionsModel.settingsWritesForTest(), 1) }
    function test_native_validation_failure_keeps_the_literal_and_writes_nothing() { const page = view(); optionsModel.rejectSettingsForTest("Captured native policy rejection"); edit(page, "proxy", "127.0.0.1:9050"); findChild(page, "settingsSaveBatchButton").clicked(); tryCompare(page.settingsEditor, "error", "Captured native policy rejection"); compare(page.settingsEditor.entry("proxy").text, "127.0.0.1:9050"); compare(page.settingsEditor.dirty, true); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_keep_editing_preserves_the_original_navigation_and_draft() { const page = view(); edit(page, "proxy", "127.0.0.1:9050"); question(page, "storage"); findChild(page, "settingsCloseKeep").clicked(); tryCompare(page.settingsEditor, "closeQuestion", false); compare(page.selectedSectionId, "connection"); compare(page.settingsEditor.entry("proxy").text, "127.0.0.1:9050"); compare(page.settingsEditor.dirty, true); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_discard_navigation_opens_a_fresh_editor_without_a_write() { const page = view(); const original = page.settingsEditor.editorId; edit(page, "proxy", "127.0.0.1:9050"); question(page, "storage"); findChild(page, "settingsCloseDiscard").clicked(); tryCompare(page, "selectedSectionId", "storage"); tryCompare(page.settingsEditor, "fresh", true); verify(page.settingsEditor.editorId !== original); compare(page.settingsEditor.entry("proxy").text, ""); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_done_waits_for_the_original_save_outcome() { const page = view(); const spy = createTemporaryObject(doneSpy, testCase, {target: page}); edit(page, "proxy", "127.0.0.1:9050"); page.requestSettingsNavigation("", true); tryCompare(page.settingsEditor, "closeQuestion", true); compare(spy.count, 0); compare(optionsModel.settingsWritesForTest(), 0); findChild(page, "settingsCloseSave").clicked(); tryCompare(spy, "count", 1); compare(optionsModel.settingsWritesForTest(), 1) }
    function test_an_open_consent_cannot_retarget_to_another_section() { const page = view(); edit(page, "proxy", "127.0.0.1:9050"); question(page, "storage"); page.requestSettingsNavigation("about", false); compare(page.pendingSettingsSection, "storage"); findChild(page, "settingsCloseDiscard").clicked(); tryCompare(page, "selectedSectionId", "storage"); compare(optionsModel.settingsWritesForTest(), 0) }
    function test_stale_close_consent_cannot_discard_a_successor_edit() { const page = view(); edit(page, "proxy", "127.0.0.1:9050"); question(page, "storage"); const editor = page.settingsEditor; const token = editor.closeToken; editor.entry("proxy").editText("127.0.0.1:9150"); tryCompare(editor.entry("proxy"), "text", "127.0.0.1:9150"); tryVerify(() => editor.closeToken !== token); editor.answerClose(token, SettingsEditorModel.Discard); wait(0); compare(page.selectedSectionId, "connection"); compare(editor.closeQuestion, true); compare(editor.dirty, true); editor.answerClose(editor.closeToken, SettingsEditorModel.KeepEditing); tryCompare(editor, "closeQuestion", false) }
    function test_prune_mode_changes_preserve_550_mib_exactly() { const page = view(); page.selectSection("storage"); compare(page.settingsEditor.entry("prune").text, "550"); page.settingsEditor.setPruneMode(SettingsEditorModel.Disabled); tryCompare(page.settingsEditor.entry("prune"), "text", "0"); page.settingsEditor.setPruneMode(SettingsEditorModel.Automatic); tryCompare(page.settingsEditor.entry("prune"), "text", "550"); save(page); verify(page.settingsEditor.saveResult.actualValues.indexOf("prune = 550") >= 0) }
    function test_restart_notice_uses_saved_policy_and_remains_global() { const page = view(); page.settingsEditor.entry("listen").editBoolean(false); tryCompare(page.settingsEditor, "canSave", true); compare(page.settingsEditor.restartRequired, false); save(page); compare(page.settingsEditor.restartRequired, true); page.selectSection("about"); compare(page.settingsEditor.restartNoticeVisible, true); verify(findChild(page, "settingsRestartNotice").visible); page.settingsEditor.acknowledgeRestart(); tryCompare(page.settingsEditor, "restartNoticeVisible", false); compare(page.settingsEditor.restartRequired, true) }
    function test_live_only_changes_do_not_request_a_restart() { const page = view(); page.settingsEditor.entry("natpmp").editBoolean(true); tryCompare(page.settingsEditor, "canSave", true); save(page); compare(page.settingsEditor.restartRequired, false); compare(page.settingsEditor.entry("natpmp").effectiveText, "true") }
    function test_multiple_fields_share_one_native_batch() { const page = view(); edit(page, "proxy", "127.0.0.1:9050"); edit(page, "onion", "127.0.0.1:9150"); save(page); compare(optionsModel.settingsWritesForTest(), 1); verify(page.settingsEditor.saveResult.actualValues.indexOf("proxy = 127.0.0.1:9050") >= 0); verify(page.settingsEditor.saveResult.actualValues.indexOf("onion = 127.0.0.1:9150") >= 0) }
}
